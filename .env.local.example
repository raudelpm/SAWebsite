RESEND_API_KEY=replace_me
REQUEST_TO_EMAIL=info@screenarmors.com
# IMPORTANT: REQUEST_FROM_EMAIL must be a Resend-verified sender/domain.
# Example once domain is verified:
# REQUEST_FROM_EMAIL="Screen Armors <no-reply@screenarmors.com>"
REQUEST_FROM_EMAIL=replace_me

# Required for local AI lead emails AND the quote form when using `npm run dev:api`
# (vercel dev loads .env.local). Without RESEND_API_KEY + REQUEST_TO_EMAIL +
# REQUEST_FROM_EMAIL, submit_estimate_request will fail with a logged config error.
# Use the same verified FROM address/domain as production quote form emails.

# AI website chat assistant (server-side only — never expose in Website/ frontend)
OPENAI_API_KEY=replace_me

# Admin porch calculator (/admin/porch-calculator.html)
# Set these in Vercel Project Settings → Environment Variables (never commit real values).
ADMIN_USERS=eddy,raudel
ADMIN_PASSWORD=replace_me
ADMIN_SESSION_SECRET=replace_with_long_random_string

# Online porch estimate database (Vercel Blob). Without this, local/dev uses .data/porch-estimates.json
BLOB_READ_WRITE_TOKEN=replace_me
