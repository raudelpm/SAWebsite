RESEND_API_KEY=replace_me
REQUEST_TO_EMAIL=info@screenarmors.com
# IMPORTANT: REQUEST_FROM_EMAIL must be a Resend-verified sender/domain.
# Example once domain is verified:
# REQUEST_FROM_EMAIL="Screen Armors <no-reply@screenarmors.com>"
REQUEST_FROM_EMAIL=replace_me

# Optional: Jobber client custom field configuration id for website lead source
# (ClientCreateInput.customFields). Built-in Jobber "Lead source" on API clients
# is set to your OAuth app name and is not writable via ClientCreateInput.
# JOBBER_LEAD_SOURCE_CUSTOM_FIELD_CONFIG_ID=replace_me
# JOBBER_LEAD_SOURCE_CUSTOM_FIELD_VALUE_KEY=valueText

